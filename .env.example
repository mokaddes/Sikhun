APP_NAME="Sikhun.com"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000
APP_LOCALE=bn

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sikhun
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sikhun.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- AI Providers ----
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434
VLLM_ENDPOINT=http://localhost:8000

# ---- Payments ----
ZINIPAY_API_KEY=
ZINIPAY_IS_SANDBOX=true
ZINIPAY_API_URL=https://api.zinipay.com
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_KEY=

# ---- Firebase (push notifications) ----
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=storage/app/firebase-credentials.json

# ---- Reverb (WebSockets) ----
REVERB_APP_ID=sikhun-local
REVERB_APP_KEY=sikhun-key
REVERB_APP_SECRET=sikhun-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---- Scout / Meilisearch ----
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ---- SEO ----
SITEMAP_URL="${APP_URL}/sitemap.xml"

# ---- Referral rewards ----
REFERRAL_REWARD_REFERRER=20
REFERRAL_REWARD_REFEREE=20
